<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.asialjim</groupId>
        <artifactId>cache4j</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cache4j-spring-redis</artifactId>
    <packaging>jar</packaging>
    <name>AsialJim::Cache4J::Spring::Redis</name>
    <description>接入 Spring Data Redis：用 RedisConnectionFactory 实现 RedisValueStore&lt;V&gt;；key 布局 / envelope / Lua / serializer 都在本模块</description>

    <properties>
        <spring-data-redis.version>4.1.1</spring-data-redis.version>
        <lettuce.version>7.5.2.RELEASE</lettuce.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.asialjim</groupId>
            <artifactId>cache4j-central-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          ~ 只依赖 spring-data-redis 的 API：不依赖 spring-boot-starter-data-redis，
          ~ 也不锁定 Jedis / Lettuce —— 底层客户端由用户自己引入。
          -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <version>${spring-data-redis.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试用客户端（Lettuce）：只在 test 作用域，不进传递依赖 -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>${lettuce.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
