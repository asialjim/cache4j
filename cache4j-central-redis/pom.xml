            <groupId>com.asialjim</groupId>
            <artifactId>cache4j-central</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          ~ 仅测试作用域：端到端用例需要「门面 + 本地缓存 + Redis 语义层 + 适配层 store」全栈。
          ~ 编译期依赖方向不变（central-redis 只依赖 central）。
          -->
        <dependency>
            <groupId>com.asialjim</groupId>
            <artifactId>cache4j-local</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
