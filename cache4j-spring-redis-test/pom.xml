<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.asialjim</groupId>
        <artifactId>cache4j</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cache4j-spring-redis-test</artifactId>
    <packaging>jar</packaging>
    <name>cache4j-spring-redis-test</name>
    <description>集成测试模块：在真实 Redis 环境下验证 Spring + 二级缓存的完整链路（只含测试，不产出可依赖的 API）</description>

    <properties>
        <spring-framework.version>7.0.9</spring-framework.version>
        <lettuce.version>7.5.2.RELEASE</lettuce.version>
    </properties>

    <dependencies>
        <!-- 全部 test 作用域：本模块只提供集成测试，不被其它模块依赖 -->
        <dependency>
            <groupId>com.asialjim</groupId>
            <artifactId>cache4j-spring</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.asialjim</groupId>
            <artifactId>cache4j-spring-redis</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.asialjim</groupId>
            <artifactId>cache4j-local-caffeine</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring-framework.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>${lettuce.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
